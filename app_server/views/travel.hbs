<div class="box">
    <div>
        <div class="body">
            <h1>Travel</h1>
            <h2>Travel Destination List</h2>
            <p>
                In seminars, conferences, and workshops around the globe, people are coming together to explore and collaborate on new ideas. Find your next travel destination below.
            </p>

            <ul id="sites">
                {{#each trips}}
                <li>
                    <a href="/travel">
                        <img src="/images/{{image}}" alt="{{name}}">
                    </a>

                    <h2>
                        <a href="/travel">{{name}}</a>
                    </h2>

                    <p>{{description}}</p>
                    <p>{{more}}</p>
                </li>
                {{/each}}
            </ul>
        </div>
    </div>
</div>
